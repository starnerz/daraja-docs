---
/**
 * Starlight's own footer, with who maintains the package and a trademark
 * notice under it.
 *
 * This site documents an independent package whose name carries two other
 * companies' marks, on a domain that carries one of them. Saying so once, on
 * every page, is what keeps that an accurate description of an open-source
 * project rather than an implied endorsement — and it is cheaper to publish
 * now than to be asked for later.
 */
import Default from '@astrojs/starlight/components/Footer.astro';
import DarajaMark from './marks/DarajaMark.astro';
import EazysoftMark from './marks/EazysoftMark.astro';
---

<Default><slot /></Default>

<p class="credit">
    <DarajaMark size={18} class="credit__mark" />
    <span>
        Laravel Daraja is free and open source, maintained by{' '}
        <a class="credit__by" href="https://eazysoft.africa"><EazysoftMark size={13} />eazysoft</a>.
    </span>
    <a class="credit__tip" href="https://paystack.shop/pay/laravel-daraja">Support development</a>
</p>

<p class="disclaimer">
    An independent open-source project, not affiliated with, endorsed by, or sponsored
    by Safaricom PLC or Laravel LLC. <i>M-Pesa</i> and <i>Daraja</i> are trademarks of
    Safaricom PLC; <i>Laravel</i> is a trademark of Laravel LLC. Used here only to say
    what this package works with.
</p>

<style>
    .credit {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 1.5rem;
        padding-top: 1rem;
        border-top: 1px solid var(--sl-color-gray-6);
        font-size: var(--sl-text-sm);
        color: var(--sl-color-gray-2);
    }

    .credit :global(.credit__mark) {
        flex: none;
        color: var(--sl-color-white);
    }

    .credit__by {
        display: inline-flex;
        align-items: center;
        gap: 0.2rem;
        font-weight: 700;
        letter-spacing: -0.04em;
        vertical-align: bottom;
        white-space: nowrap;
        color: var(--sl-color-white);
    }

    .credit__tip {
        flex: none;
        margin-left: auto;
        padding: 0.35rem 0.85rem;
        border: 1px solid var(--sl-color-accent);
        border-radius: 999px;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        color: var(--sl-color-text-accent);
    }

    .credit__tip:hover {
        color: var(--sl-color-black);
        background: var(--sl-color-accent);
    }

    .disclaimer {
        margin-top: 1rem;
        font-size: var(--sl-text-xs);
        line-height: 1.6;
        color: var(--sl-color-gray-3);
        text-wrap: pretty;
    }

    .disclaimer i {
        font-style: normal;
        color: var(--sl-color-gray-2);
    }
</style>
